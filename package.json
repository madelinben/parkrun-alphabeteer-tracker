{
  "name": "@get-out-there/alphabeteer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Track the parkrun events you have run (manually or from Strava) and your A to Z alphabeteer progress, with the nearest event for every missing letter. Embedded in get-out-there; also deployed standalone to GitHub Pages from demo/.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts && touch docs/.nojekyll",
    "ts-check": "tsc --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "parkruns:update": "node scripts/update-parkruns.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": ">=0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.80.0",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
